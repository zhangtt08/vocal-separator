# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/release/
/.edge-audit/
/capture-ui.log
/ui-*.png

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backend 运行时（上传/输出/历史索引自动清理；ffmpeg 二进制体积大，本机保留）
backend/__pycache__/
backend/uploads/
backend/outputs/
backend/history.json
backend/ffmpeg.exe

# 本机服务闸门的共享令牌（桌面壳生成，绝不能入库）
backend/security.json
security.json

# Agent API 运行时产物（服务地址回执、字节码；都可再生）
agent/.endpoint
agent/__pycache__/

# 任何位置的日志与临时抓取残留
__pycache__/
*.log
/capture-*
/ui-*.png

# Windows 快捷方式（本机启动用，不入库）
*.lnk

# 闸门共享令牌（本机后端与桌面壳之间；运行时生成，不入库）
backend/security.json
