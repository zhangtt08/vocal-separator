{
  "name": "vocal-separator",
  "version": "0.1.1",
  "private": true,
  "description": "声析：本地 AI 音轨分离桌面软件",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:backend": "python -m unittest discover -s backend -v",
    "agent:serve": "python agent/server.py",
    "agent:mcp": "node agent/mcp-server.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dir": "npm run build && electron-builder --win dir",
    "desktop:pack": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "next": "^16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "png-to-ico": "^3.0.2",
    "shadcn": "^4.14.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "cn.shengxi.vocalseparator",
    "productName": "声析",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release",
      "buildResources": "desktop-assets"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "main.py",
          "agent_api.py",
          "requirements.txt",
          "ffmpeg.exe"
        ]
      },
      {
        "from": "agent",
        "to": "agent",
        "filter": [
          "tools.py",
          "errors.py"
        ]
      },
      {
        "from": "desktop-assets/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop-assets/icon.ico",
      "artifactName": "声析-${version}-Windows-${arch}.${ext}"
    }
  }
}
